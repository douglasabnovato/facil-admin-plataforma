# Copie para .env.development.local e preencha (nunca versione o arquivo preenchido).
# Supabase → Project Settings → API (ou a saída de `npx supabase start` no ambiente local)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Caminho publicado: "/" no local; "/facil-admin-plataforma/" no GitHub Pages (o deploy já define)
VITE_BASE=/
